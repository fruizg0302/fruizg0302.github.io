---
import IconHash from "@/assets/icons/IconHash.svg";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;
---

<li>
  <a
    href={`/tags/${tag}/`}
    transition:name={tag}
    class:list={[
      "flex items-center gap-0.5 rounded-md px-2 py-0.5",
      "bg-surface-1/50 hover:bg-accent/20",
      "hover:text-accent",
      "focus-visible:text-accent focus-visible:outline-none",
      { "text-sm": size === "sm" },
      { "text-lg": size === "lg" },
    ]}
    style="font-family: var(--font-heading);"
  >
    <IconHash
      class:list={[
        "opacity-80",
        { "size-5": size === "lg" },
        { "size-4": size === "sm" },
      ]}
    />
    {tagName}
  </a>
</li>
